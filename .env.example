# ---------------------------------------------------------------------------
# ChinaBridge BD — environment
# Copy to .env.local and adjust. Every value below is optional for local dev:
# without DATABASE_URL the app runs on embedded PGlite (Postgres in WASM).
# ---------------------------------------------------------------------------

# Real PostgreSQL (recommended for production / staging).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chinabridge

# better-auth
BETTER_AUTH_SECRET=change-me-to-a-32-character-random-string
BETTER_AUTH_URL=http://localhost:3000

# Optional: where PGlite keeps its data directory (defaults to ./.data/pgdata)
# PGLITE_DIR=./.data/pgdata
